---
import Base from "@/layouts/Base.astro";
import { getCollection, getEntry } from "astro:content";
import { Image } from "astro:assets";
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, slugify } from "@/lib/utils/textConverter";
import { BiCalendarEdit, BiCategoryAlt } from "react-icons/bi";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { single: post.slug || post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Base 
  title={post.data.title} 
  description={post.data.description}
  image={post.data.image}
  schemaType="article"
  datePublished={post.data.date}
  dateModified={post.data.updatedDate || post.data.date}
>
  <section class="section">
    <div class="container">
      <article class="row justify-center">
        <div class="col-12 lg:col-10">
          <h1 class="h2 mb-4">{post.data.title}</h1>
          
          <ul class="mb-6 text-text flex flex-wrap items-center text-sm">
            <li class="mb-2 mr-4 flex items-center flex-wrap font-medium">
              <BiCalendarEdit className="mr-1 h-[16px] w-[16px] text-gray-600" />
              {dateFormat(post.data.date!)}
            </li>
            <li class="mb-2 mr-4 flex items-center flex-wrap">
              <BiCategoryAlt className="mr-1 h-[16px] w-[16px] text-gray-600" />
              <ul>
                {post.data.categories.map((category, i: number) => (
                  <li class="inline-block">
                    <a
                      href={`/categories/${slugify(category)}`}
                      class="mr-2 hover:text-primary font-medium"
                    >
                      {humanize(category)}
                      {i !== post.data.categories.length - 1 && ","}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          </ul>

          {post.data.image && (
            <div class="mb-8 rounded-lg overflow-hidden">
              <Image
                class="w-full"
                src={post.data.image}
                alt={post.data.title}
                width={920}
                height={480}
                loading="eager"
              />
            </div>
          )}

          <div class="content">
            <Content />
          </div>
        </div>
      </article>
    </div>
  </section>
</Base>