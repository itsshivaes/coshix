---
import Base from "../layouts/Base.astro";
---

<Base title="404 - Page Not Found" description="The page you are looking for does not exist.">
  <div class="not-found-wrapper">
    <div class="not-found-card">
      
      <div class="illustration-container">
        <div class="floating-circle c1"></div>
        <div class="floating-circle c2"></div>
        <div class="error-code-badge">404</div>
      </div>

      <h1 class="error-title">Page not found</h1>
      <p class="error-description">
        Oops! The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
      </p>

      <div class="action-buttons">
        <a href="/" class="btn-primary">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          Back to Home
        </a>
        <button onclick="window.history.back()" class="btn-secondary">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
          Go Back
        </button>
      </div>

    </div>
  </div>
</Base>

<style>
  .not-found-wrapper {
    width: 100%;
    min-height: calc(100vh - 140px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    box-sizing: border-box;
  }

  .not-found-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 1rem;
    padding: 3rem 2.5rem;
    max-width: 520px;
    width: 100%;
    text-align: center;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.03);
    box-sizing: border-box;
  }

  /* Animated Illustration Container */
  .illustration-container {
    position: relative;
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .error-code-badge {
    font-size: 3.5rem;
    font-weight: 800;
    background: linear-gradient(135deg, #4f46e5 0%, #818cf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.05em;
    position: relative;
    z-index: 2;
    animation: floatBadge 3s ease-in-out infinite;
  }

  .floating-circle {
    position: absolute;
    border-radius: 50%;
    opacity: 0.15;
  }

  .c1 {
    width: 100px;
    height: 100px;
    background: #4f46e5;
    top: 10px;
    left: calc(50% - 80px);
    animation: pulseCircle 4s ease-in-out infinite;
  }

  .c2 {
    width: 70px;
    height: 70px;
    background: #818cf8;
    bottom: 10px;
    right: calc(50% - 80px);
    animation: pulseCircle 4s ease-in-out infinite 2s;
  }

  @keyframes floatBadge {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @keyframes pulseCircle {
    0%, 100% { transform: scale(1); opacity: 0.15; }
    50% { transform: scale(1.15); opacity: 0.25; }
  }

  .error-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-main);
    margin: 0 0 0.75rem 0;
    letter-spacing: -0.02em;
  }

  .error-description {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0 auto 2rem auto;
    max-width: 400px;
  }

  .action-buttons {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    align-items: center;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #4f46e5;
    color: #ffffff;
    padding: 0.65rem 1.25rem;
    border-radius: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .btn-primary:hover {
    background: #4338ca;
    transform: translateY(-1px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-main);
    color: var(--text-main);
    border: 1px solid var(--border-color);
    padding: 0.65rem 1.25rem;
    border-radius: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.15s ease;
    font-family: inherit;
  }

  .btn-secondary:hover {
    background: var(--sidebar-hover);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .not-found-card {
      padding: 2rem 1.25rem;
    }
    .action-buttons {
      flex-direction: column;
      width: 100%;
    }
    .btn-primary, .btn-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>