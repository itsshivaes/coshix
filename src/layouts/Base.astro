      const savedLang = localStorage.getItem('user_selected_lang') || 'en';
      const rtlLangs = ["ar", "fa", "ur", "he", "ps", "yi", "sd", "ug"];
      if (rtlLangs.includes(savedLang.split('-')[0].toLowerCase())) {
        document.documentElement.dir = 'rtl';
        document.documentElement.classList.add('Rtl');
