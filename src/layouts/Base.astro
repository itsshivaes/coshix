---
import { getCollection } from "astro:content";
import Schema from "src/layouts/components/schema.astro";

const allPosts = await getCollection("posts");
const searchData = allPosts.map(post => ({
  title: post.data.title,
  url: `/blog/${post.slug || post.id}`,
  category: post.data.categories?.[0] || "General",
  date: post.data.date ? new Date(post.data.date).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : ""
}));

// Languages matching Lantro UI
const languages = [
  { code: 'en', name: 'English' },
  { code: 'es', name: 'Spanish' },
  { code: 'fr', name: 'French' },
  { code: 'de', name: 'German' },
  { code: 'hi', name: 'Hindi' },
  { code: 'bn', name: 'Bengali' },
  { code: 'ar', name: 'Arabic' },
  { code: 'id', name: 'Indonesian' },
  { code: 'ru', name: 'Russian' },
  { code: 'nl', name: 'Dutch' },
  { code: 'zh-CN', name: 'Chinese' },
  { code: 'ja', name: 'Japanese' },
  { code: 'ko', name: 'Korean' },
  { code: 'th', name: 'Thai' },
  { code: 'pl', name: 'Polish' }
];

interface Props {
  title?: string;
  description?: string;
  image?: string;
  schemaType?: 'website' | 'article' | 'page';
  datePublished?: string;
  dateModified?: string;
}

const { 
  title = "Coshix", 
  description = "Coshix is a modern web platform offering tutorials, developer tools, Blogger guides, UI components, and resources to help you build better websites.", 
  image = "/images/og-image.png",
  schemaType = "page",
  datePublished,
  dateModified
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://coshix.in");
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#4f46e5" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, canonicalURL)} />

    <!-- Schema.org Rich Results Support -->
    <Schema 
      type={schemaType}
      title={title}
      description={description}
      url={canonicalURL.toString()}
      image={image}
      datePublished={datePublished}
      dateModified={dateModified}
    />
    
    <!-- Optimized Google Fonts to prevent render-blocking -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:wght@400;500;600;700&display=swap">
    </noscript>

        <style is:global is:inline>
      /* Clean, Modern macOS Colors */
      :root {
        --bg-main: #ffffff;
        --bg-card: #ffffff;
        --text-main: #1d1d1f;
        --text-muted: #64748b;
        --border-color: #e5e7eb;
        
        /* Frosted Glass Header */
        --header-bg: rgba(255, 255, 255, 0.85);
        --cookie-bg: rgba(255, 255, 255, 0.95);
        
        /* Sidebar Styling (Matches Header/White) */
        --sidebar-bg: var(--header-bg);
        --sidebar-hover: #f3f4f6;
        --sidebar-active: #eef2ff;
        --sidebar-active-text: #4f46e5;
        
        --scrollbar-bg: #ffffff;
        --scrollbar-thumb: #d1d5db;
        --scrollbar-thumb-hover: #9ca3af;
      }

      html.dark {
        --bg-main: #000000;
        --bg-card: #0a0a0a;
        --text-main: #f5f5f7;
        --text-muted: #86868b;
        --border-color: #27272a;
        
        /* Frosted Glass Header Dark - OPACITY LOWERED TO PRESERVE BLUR IN PRODUCTION */
        --header-bg: rgba(10, 10, 10, 0.5);
        --cookie-bg: rgba(20, 20, 20, 0.85);
        
        /* Sidebar Styling Dark */
        --sidebar-bg: var(--header-bg);
        --sidebar-hover: #27272a;
        --sidebar-active: rgba(129, 140, 248, 0.15);
        --sidebar-active-text: #818cf8;

        --scrollbar-bg: #000000;
        --scrollbar-thumb: #38383a;
        --scrollbar-thumb-hover: #48484a;
      }

      /* --- RTL & Dropdown Positioning Fixes --- */
      html.Rtl, html[dir="rtl"] { direction: rtl; text-align: right; }
      
      /* Fix Dropdown Menus in RTL Mode (Pin them to the left side of their container instead of right) */
      html.Rtl .dropdown-container .dropdown-menu, 
      html[dir="rtl"] .dropdown-container .dropdown-menu { 
        right: auto !important; 
        left: 0 !important; 
      }
      
      html.Rtl .dropdown-option, html[dir="rtl"] .dropdown-option { text-align: right; }
      html.Rtl .search-trigger kbd, html[dir="rtl"] .search-trigger kbd { margin-left: 0; margin-right: auto; }
      html.Rtl .sidebar, html[dir="rtl"] .sidebar { border-right: none; border-left: 1px solid var(--border-color); }
      html.Rtl .back-to-top-btn, html[dir="rtl"] .back-to-top-btn { right: auto; left: 2rem; }
      html.Rtl .copy-code-btn, html[dir="rtl"] .copy-code-btn { right: auto; left: 0.5rem; }
      
      /* Mirror the grid layout columns for RTL */
      html.Rtl .dashboard-container, html[dir="rtl"] .dashboard-container {
        direction: rtl;
      }

      /* Hide Google Translate UI Overlay & Headers */
      .VIpgJd-ZVi9od-aZ2wEe-wOHMyf, .VIpgJd-ZVi9od-aZ2wEe-OiiCO, .VIpgJd-ZVi9od-ORHb-OiiCO, .VIpgJd-y60Sfe-XLBlAb, .VIpgJd-ZVi9od-SmfZ, .goog-te-banner-frame, .goog-te-balloon-frame, #goog-gt-tt, .goog-te-spinner-pos, .goog-tooltip, .goog-tooltip:hover, .skiptranslate {
        display: none !important; visibility: hidden !important; opacity: 0 !important; pointer-events: none !important;
      }
      body { top: 0 !important; position: static !important; }
      font[style] { background-color: transparent !important; box-shadow: none !important; }

      /* Custom Scrollbar */
      html { scrollbar-width: thin; scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-bg); }
      ::-webkit-scrollbar { width: 12px; height: 12px; }
      ::-webkit-scrollbar-track { background: var(--scrollbar-bg); }
      ::-webkit-scrollbar-thumb { background: var(--scrollbar-thumb); border-radius: 8px; border: 3px solid var(--scrollbar-bg); }
      ::-webkit-scrollbar-thumb:hover { background: var(--scrollbar-thumb-hover); }

      body.app-body {
        margin: 0;
        font-family: 'Google Sans Flex', ui-sans-serif, system-ui, -apple-system, sans-serif;
        background-color: var(--bg-main);
        color: var(--text-main);
        min-height: 100vh;
        box-sizing: border-box;
      }

      .top-navbar {
        height: 65px;
        background-color: var(--header-bg) !important;
        backdrop-filter: saturate(180%) blur(20px) !important;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 1.5rem;
        position: sticky;
        top: 0;
        z-index: 50;
      }

      .nav-left { display: flex; align-items: center; gap: 1.5rem; }
      .brand-logo { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; }
      .brand-logo-img { width: 32px; height: 32px; object-fit: contain; border-radius: 0.375rem; }
      .brand-name { font-size: 1.15rem; font-weight: 500; color: var(--text-main); }
      
      .nav-right { display: flex; align-items: center; gap: 0.75rem; }

      /* Search Bar  */
      .search-trigger {
        display: flex; align-items: center; gap: 0.5rem; background: var(--sidebar-hover); border: 1px solid transparent;
        padding: 0.45rem 1rem; border-radius: 0.5rem; color: #1d2229; font-size: 0.85rem; cursor: pointer;
        width: 320px; text-align: left; font-family: inherit; transition: all 0.2s ease; margin-left: 1.5rem;
      }
      html .dark .search-trigger { color:var(--text-muted);}
      html[dir="rtl"] .search-trigger, html.Rtl .search-trigger { margin-left: 0; margin-right: 1.5rem; text-align: right; }
      
      .search-trigger:hover {
        background: var(--bg-card);
        border-color: var(--border-color);
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
      }
      .search-trigger kbd {
        background: var(--bg-card); border: 1px solid var(--border-color); padding: 0.15rem 0.4rem; border-radius: 0.25rem;
        font-size: 0.65rem; font-weight: 600; color: var(--text-muted); margin-left: auto; box-shadow: 0 1px 2px rgba(0,0,0,0.02);
      }
      html[dir="rtl"] .search-trigger kbd, html.Rtl .search-trigger kbd { margin-left: 0; margin-right: auto; }

      /* Search Modal */
      .search-modal-overlay {
        display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px); z-index: 1000; justify-content: center; align-items: flex-start; padding-top: 10vh;
      }
      .search-modal-overlay.show { display: flex; }
      .search-modal-box { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 0.75rem; width: 100%; max-width: 600px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); overflow: hidden; }
      .search-modal-input-wrapper { display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--border-color); color: var(--text-muted); }
      .search-modal-input-wrapper input { flex: 1; background: transparent; border: none; outline: none; font-size: 1rem; color: var(--text-main); font-family: inherit; }
      .search-close-kbd { background: var(--bg-main); border: 1px solid var(--border-color); color: var(--text-muted); padding: 0.2rem 0.5rem; border-radius: 0.25rem; font-size: 0.75rem; cursor: pointer; font-family: inherit; }
      .search-results-container { padding: 1rem; max-height: 350px; overflow-y: auto; display: flex; flex-direction: column; gap: 0.5rem; }
      .search-placeholder-text { color: var(--text-muted); font-size: 0.9rem; text-align: center; margin: 1rem 0; }
      .search-result-item { display: block; padding: 0.75rem 1rem; border-radius: 0.5rem; text-decoration: none; background: var(--bg-main); border: 1px solid var(--border-color); transition: border-color 0.15s; }
      .search-result-item:hover { border-color: #4f46e5; }
      .search-result-meta { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; color: #4f46e5; margin-bottom: 0.2rem; letter-spacing: 0.05em; }
      .search-result-title { font-size: 0.95rem; font-weight: 600; color: var(--text-main); }

      .icon-btn {
        background: transparent; border: 1px solid var(--border-color); color: var(--text-muted); width: 38px; height: 38px;
        border-radius: 0.5rem; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.15s;
      }
      .icon-btn:hover { background: var(--sidebar-hover); color: var(--text-main); }

      /* Mobile Drawer */
      .mobile-drawer-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); backdrop-filter: blur(4px); z-index: 1000; justify-content: flex-start; animation: fadeInOverlay 0.2s ease; }
      .mobile-drawer-overlay.show { display: flex; }
      .mobile-drawer-content { background: var(--bg-card); width: 82%; max-width: 320px; height: 100%; display: flex; flex-direction: column; box-shadow: 5px 0 25px rgba(0, 0, 0, 0.15); animation: slideInDrawer 0.25s cubic-bezier(0.16, 1, 0.3, 1); overflow-y: auto; }
      .mobile-drawer-header { padding: 1rem 1.25rem; border-bottom: 1px solid var(--border-color); display: flex; justify-content: flex-start; align-items: center; }
      .drawer-close-btn { background: transparent; border: none; color: var(--text-muted); display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; font-weight: 600; cursor: pointer; padding: 0.25rem 0.5rem; border-radius: 0.375rem; font-family: inherit; }
      .drawer-close-btn:hover { background: var(--sidebar-hover); color: var(--text-main); }
      .mobile-drawer-body { padding: 1.25rem 1rem; display: flex; flex-direction: column; gap: 1.5rem; }
      @keyframes slideInDrawer { from { transform: translateX(-100%); } to { transform: translateX(0); } }
      @keyframes fadeInOverlay { from { opacity: 0; } to { opacity: 1; } }

      /* Dropdowns */
      .dropdown-container { position: relative; }
      .dropdown-menu { display: none; position: absolute; right: 0; top: 45px; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 0.75rem; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2); width: 180px; padding: 0.5rem; z-index: 100; }
      .dropdown-menu.show { display: block; }
      .dropdown-menu-header { font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; padding: 0.5rem 0.75rem; letter-spacing: 0.05em; }
      .dropdown-option { width: 100%; display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem 0.75rem; background: transparent; border: none; border-radius: 0.375rem; color: var(--text-main); font-size: 0.9rem; cursor: pointer; text-align: left; font-family: inherit; }
      html[dir="rtl"] .dropdown-option, html.Rtl .dropdown-option { text-align: right; }
      .dropdown-option:hover { background: var(--sidebar-hover); }
      .lang-menu-scroll { max-height: 350px; overflow-y: auto; }
      .check-icon { visibility: hidden; color: #4f46e5; }
      .dropdown-option.active .check-icon { visibility: visible; }

      /* DASHBOARD GRID & STICKY SIDEBAR */
      .dashboard-container {
        display: grid;
        grid-template-columns: 240px 1fr;
        align-items: start;
        width: 100%;
        min-width: 0 !important;
      }

      .sidebar {
        background-color: var(--sidebar-bg);
        backdrop-filter: saturate(180%) blur(20px);
        border-right: 1px solid var(--border-color);
        min-height: calc(100vh - 65px);
        position: sticky;
        top: 65px;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        z-index: 40;
      }
      html[dir="rtl"] .sidebar, html.Rtl .sidebar {
        border-right: none;
        border-left: 1px solid var(--border-color);
      }

      .sidebar-inner {
        padding: 1.5rem 0.75rem;
        display: flex;
        flex-direction: column;
        flex: 1;
      }

      .sidebar-section { display: flex; flex-direction: column; gap: 0.25rem; margin-bottom: 1.5rem;}
      .sidebar-title { font-size: 0.7rem; font-weight: 600; color: var(--text-muted); letter-spacing: 0.05em; padding: 0.5rem 0.75rem; }
      .sidebar-link { display: flex; align-items: center; padding: 0.6rem 0.75rem; border-radius: 0.5rem; color: var(--text-muted); text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: all 0.15s ease; }
      .sidebar-link:hover { background: var(--sidebar-hover); color: var(--text-main); }
      .sidebar-link.active { background-color: var(--sidebar-active); color: var(--sidebar-active-text); font-weight: 600; }

      .sidebar-social-section { margin-top: auto; padding-top: 1.5rem; border-top: 1px solid var(--border-color); }
      .social-section-title { font-size: 0.8rem; font-weight: 600; color: var(--text-main); text-align: center; margin-bottom: 0.75rem; }
      .social-icons-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.4rem; justify-items: center; }
      .social-icon-link { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; color: var(--text-muted); border: 1px solid var(--border-color); background: var(--bg-card); transition: all 0.15s ease; }
      .social-icon-link:hover { color: #4f46e5; border-color: #4f46e5; background: var(--sidebar-hover); }

      .content-wrapper {
        display: flex;
        flex-direction: column;
        min-height: calc(100vh - 65px);
        justify-content: space-between;
        min-width: 0 !important;
      }

      .main-content {
        padding: 2.5rem;
        max-width: 1200px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
        min-width: 0 !important;
      }

      .site-footer { background-color: transparent; border-top: 1px solid var(--border-color); padding: 1.5rem 2.5rem; margin-top: auto; }
      .footer-content { max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; font-size: 0.85rem; color: var(--text-muted); }
      .footer-links { display: flex; gap: 1.5rem; }
      .footer-links a { color: var(--text-muted); text-decoration: none; transition: color 0.15s ease; }
      .footer-links a:hover { color: var(--text-main); }

      img.lazy { opacity: 0; transition: opacity 0.3s ease-in-out; }
      img:not(.lazy) { opacity: 1; transition: opacity 0.3s ease-in-out; }

      pre { position: relative; }
      
      /* Allow Shiki to render correctly */
      .content-body pre { 
        background: transparent !important; 
        padding: 1.25rem !important; 
        margin: 0 !important; 
        border: none !important; 
        border-radius: 0 !important; 
        overflow-x: auto !important; 
        max-width: 100% !important; 
      }
      
      .content-body pre code { 
        background: transparent !important; 
        padding: 0 !important; 
        border: none !important; 
        word-break: normal; 
        white-space: pre !important; 
        -webkit-font-smoothing: antialiased; 
        -moz-osx-font-smoothing: grayscale; 
        font-weight: 500; 
        font-size: 0.9rem; 
        letter-spacing: 0.2px;
      }

      .back-to-top-btn { position: fixed; bottom: 5rem; right: 2rem; background: #4f46e5; color: #ffffff; width: 42px; height: 42px; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: none; cursor: pointer; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3); opacity: 0; visibility: hidden; transform: translateY(15px); transition: all 0.25s ease; z-index: 10; }
      html[dir="rtl"] .back-to-top-btn, html.Rtl .back-to-top-btn { right: auto; left: 2rem; }
      .back-to-top-btn.show { opacity: 1; visibility: visible; transform: translateY(0); }
      .back-to-top-btn:hover { background: #4338ca; transform: translateY(-3px); box-shadow: 0 6px 16px rgba(79, 70, 229, 0.4); }

      /* Dark mode component overrides */
      html.dark .post-card-featured-horizontal, html.dark .post-card-grid, html.dark .popular-card, html.dark .post-card, html.dark .post-card-horizontal-sm, html.dark .pagination-container, html.dark nav[aria-label="Pagination"], html.dark .search-modal-box, html.dark .mobile-drawer-content, html.dark .dropdown-menu { background-color: var(--bg-card) !important; border-color: var(--border-color) !important; color: var(--text-main) !important; }
      html.dark .pagination-container, html.dark nav[aria-label="Pagination"] { color: var(--text-main) !important; }
      html.dark .pagination-container a, html.dark .pagination-container button, html.dark nav[aria-label="Pagination"] a, html.dark nav[aria-label="Pagination"] button { background-color: var(--bg-card) !important; color: var(--text-main) !important; border-color: var(--border-color) !important; }
      html.dark .pagination-container a:hover, html.dark .pagination-container button:hover, html.dark nav[aria-label="Pagination"] a:hover, html.dark nav[aria-label="Pagination"] button:hover { background-color: var(--sidebar-hover) !important; color: var(--text-main) !important; }
      html.dark .featured-title, html.dark .grid-title, html.dark .popular-title, html.dark .post-title, html.dark .list-title, html.dark .search-result-title, html.dark .card-body-side h2 { color: var(--text-main) !important; }
      html.dark .card-desc, html.dark .card-footer-row, html.dark .card-footer-row-sm, html.dark .card-footer-sm, html.dark .date-text, html.dark .page-indicator { color: var(--text-muted) !important; border-color: var(--border-color) !important; }
      html.dark .card-image-side, html.dark .card-image-wrapper-top, html.dark .card-thumb-sm, html.dark .search-result-item, html.dark .page-btn.disabled { background-color: #27272a !important; border-color: var(--border-color) !important; color: var(--text-muted) !important; }
      html.dark .page-btn { background-color: var(--bg-card); border-color: var(--border-color); color: var(--text-main); }
      html.dark .popular-item { border-bottom-color: var(--border-color) !important; }

      .mobile-only { display: none !important; }
      .desktop-only { display: flex !important; }

      @media (max-width: 768px) {
        .dashboard-container { grid-template-columns: 1fr !important; }
        .desktop-sidebar { display: none !important; }
        .top-navbar { padding: 0 1rem !important; height: 65px !important; }
        .desktop-only { display: none !important; }
        .mobile-only { display: flex !important; }
        .nav-left { gap: 0.75rem !important; width: auto !important; }
        .main-content { padding: 1.5rem 1rem !important; }
        .footer-content { flex-direction: column; gap: 0.75rem; text-align: center; }
        .back-to-top-btn { bottom: 5.5rem; right: 1.25rem; width: 38px; height: 38px; }
      }

      /* Remove blue touch highlight on mobile devices */
      * { -webkit-tap-highlight-color: transparent; }

      /* Compact Mac OS Golden Gate Cookie Consent */
      .cookie-banner {
        position: fixed; bottom: 2rem; left: 50%; transform: translate(-50%, 150%); z-index: 9999;
        width: max-content; max-width: 90%; padding: 0.85rem 1.25rem; background: var(--cookie-bg);
        backdrop-filter: saturate(200%) blur(25px); border: 1px solid rgba(0, 0, 0, 0.1); border-radius: 3rem; box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.15), 0 0 0 1px rgba(0,0,0,0.05);
        display: flex; align-items: center; gap: 1.5rem; transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
      }
      html.dark .cookie-banner { border: 1px solid rgba(255, 255, 255, 0.1); box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255,255,255,0.05); }
      .cookie-banner.show { transform: translate(-50%, 0); }
      .cookie-text { font-size: 0.85rem; font-weight: 500; color: var(--text-main); margin: 0; }
      .cookie-text a { color: #4f46e5; text-decoration: none; text-underline-offset: 2px; }
      .cookie-actions { display: flex; gap: 0.5rem; }
      .cookie-btn { padding: 0.4rem 1rem; border-radius: 2rem; font-size: 0.8rem; font-weight: 600; cursor: pointer; border: none; transition: all 0.2s ease; }
      .cookie-btn-outline { background: rgba(0,0,0,0.05); color: var(--text-main); }
      html.dark .cookie-btn-outline { background: rgba(255,255,255,0.1); }
      .cookie-btn-outline:hover { background: rgba(0,0,0,0.1); }
