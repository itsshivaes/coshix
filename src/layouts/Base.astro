---
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");
const searchData = allPosts.map(post => ({
  title: post.data.title,
  url: `/blog/${post.slug || post.id}`,
  category: post.data.categories?.[0] || "General",
  date: post.data.date ? new Date(post.data.date).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : ""
}));

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = "Coshix", 
  description = "Coshix is a modern web platform offering tutorials, developer tools, Blogger guides, UI components, and resources to help you build better websites.", 
  image = "/images/og-image.png" 
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://coshix.in");
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#4f46e5" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, canonicalURL)} />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <script is:inline>
      const savedTheme = localStorage.getItem('theme') || 'system';
      const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (savedTheme === 'dark' || (savedTheme === 'system' && systemPrefersDark)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="app-body">
    
    <header class="top-navbar">
      <div class="nav-left">
        <button id="mobileMenuToggle" class="icon-btn mobile-only hamburger-btn" aria-label="Open Menu">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>

        <a href="/" class="brand-logo">
          <img src="/images/logo.png" alt="Coshix Logo" class="brand-logo-img" />
          <span class="brand-name">Coshix</span>
        </a>

        <button id="searchOpenBtnDesktop" class="search-trigger desktop-only" aria-label="Search">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <span class="search-text-label">Looking for something?</span>
          <kbd class="search-kbd">Ctrl K</kbd>
        </button>
      </div>

      <div class="nav-right">
        <button id="searchOpenBtnMobile" class="icon-btn mobile-only" aria-label="Search">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </button>

        <div class="theme-dropdown-container">
          <button id="themeMenuBtn" class="icon-btn" aria-label="Toggle theme">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
          </button>

          <div id="themeMenu" class="theme-menu">
            <div class="theme-menu-header">Appearance</div>
            <button class="theme-option" data-theme="light">
              <svg class="check-icon" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
              Light
            </button>
            <button class="theme-option" data-theme="dark">
              <svg class="check-icon" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
              Dark
            </button>
            <button class="theme-option" data-theme="system">
              <svg class="check-icon" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
              System
            </button>
          </div>
        </div>
      </div>
    </header>

    <div id="searchModal" class="search-modal-overlay">
      <div class="search-modal-box">
        <div class="search-modal-input-wrapper">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input type="text" id="searchInput" placeholder="Search articles, guides, code..." autocomplete="off" />
          <button id="searchCloseBtn" class="search-close-kbd">ESC</button>
        </div>
        <div id="searchResults" class="search-results-container">
          <p class="search-placeholder-text">Type a keyword to search posts...</p>
        </div>
      </div>
    </div>

    <div id="mobileDrawerOverlay" class="mobile-drawer-overlay">
      <div class="mobile-drawer-content">
        <div class="mobile-drawer-header">
          <button id="mobileMenuClose" class="drawer-close-btn" aria-label="Close Menu">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            <span>Close</span>
          </button>
        </div>
        <div class="mobile-drawer-body">
          <div class="sidebar-section">
            <a href="/" class="sidebar-link" data-path="/">Home</a>
            <a href="/tools" class="sidebar-link" data-path="/tools">Awesome Tools</a>
            <a href="/archive" class="sidebar-link" data-path="/archive">Blog Archive</a>
            <a href="/sitemap" class="sidebar-link" data-path="/sitemap">Sitemap</a>
          </div>

          <div class="sidebar-section">
            <div class="sidebar-title">INFORMATION</div>
            <a href="/about" class="sidebar-link" data-path="/about">About</a>
            <a href="/contact" class="sidebar-link" data-path="/contact">Contact</a>
            <a href="/privacy-policy" class="sidebar-link" data-path="/privacy-policy">Privacy Policy</a>
          </div>

          <div class="sidebar-social-section">
            <div class="social-icons-grid">
              <a href="https://www.threads.com/@coshix.in" target="_blank" rel="noopener noreferrer" aria-label="Threads" class="social-icon-link">
